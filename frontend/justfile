set quiet

static_dir := "../backend/priv/static"
dist_dir := "./dist"
assets_dir := dist_dir / "assets"

[private]
default:
    just --list

# lint project
[group("dev")]
lint: install
    npm run lint

# start development server
[group("dev")]
dev: install
    npm run dev

# build frontend and send files to the backend
[group("dev")]
build: install
    rm -rf {{ static_dir }}
    mkdir -p {{ static_dir }}
    npm run build --no-fund
    mv {{ assets_dir }}/*.css {{ assets_dir }}/client.css
    mv {{ assets_dir }}/*.js {{ assets_dir }}/client.js
    mkdir -p  {{ static_dir }}
    mv {{ dist_dir }}/* {{ static_dir }}

# download project dependencies
[group("dev")]
install:
    npm install
